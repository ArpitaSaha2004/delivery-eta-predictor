   "source": [
    "# Convert order and pickup times into datetime objects\n",
    "\n",
    "df[\"Order_Time\"] = pd.to_datetime(\n",
    "    df[\"Time_Orderd\"],\n",
    "    format=\"%H:%M:%S\",\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "df[\"Pickup_Time\"] = pd.to_datetime(\n",
    "    df[\"Time_Order_picked\"],\n",
    "    format=\"%H:%M:%S\",\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# Calculate time difference in minutes\n",
    "\n",
    "df[\"Order_to_Pickup\"] = (\n",
    "    df[\"Pickup_Time\"] - df[\"Order_Time\"]\n",
    ").dt.total_seconds() / 60\n",
    "\n",
    "print(df[[\n",
    "    \"Time_Orderd\",\n",
    "    \"Time_Order_picked\",\n",
    "    \"Order_to_Pickup\",\n",
    "    \"Time_taken(min)\"\n",
    "]].head(10))"
   ]
