   "source": [
    "# Compare order-to-pickup time with recorded delivery time\n",
    "\n",
    "comparison = df[\n",
    "    [\n",
    "        \"Time_Orderd\",\n",
    "        \"Time_Order_picked\",\n",
    "        \"Order_to_Pickup\",\n",
    "        \"Time_taken(min)\"\n",
    "    ]\n",
    "].dropna()\n",
    "\n",
    "comparison[\"Estimated_Remaining_Time\"] = (\n",
    "    comparison[\"Time_taken(min)\"] -\n",
    "    comparison[\"Order_to_Pickup\"]\n",
    ")\n",
    "\n",
    "display(comparison.sample(15, random_state=42))"
   ]
