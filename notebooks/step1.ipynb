   "source": [
    "import numpy as np\n",
    "\n",
    "# 1. Remove spaces from column names\n",
    "df.columns = df.columns.str.strip()\n",
    "\n",
    "# 2. Remove unnecessary spaces from text columns\n",
    "for col in df.select_dtypes(include=[\"object\", \"str\"]).columns:\n",
    "    df[col] = df[col].str.strip()\n",
    "\n",
    "# 3. Convert text NaN values into actual missing values\n",
    "df = df.replace([\"NaN\", \"nan\", \"\"], np.nan)\n",
    "\n",
    "# 4. Clean target column\n",
    "df[\"Time_taken(min)\"] = (\n",
    "    df[\"Time_taken(min)\"]\n",
    "    .str.extract(r\"(\\d+)\")[0]\n",
    ")\n",
    "\n",
    "df[\"Time_taken(min)\"] = pd.to_numeric(\n",
    "    df[\"Time_taken(min)\"], errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# 5. Clean weather column\n",
    "df[\"Weatherconditions\"] = (\n",
    "    df[\"Weatherconditions\"]\n",
    "    .str.replace(\"conditions \", \"\", regex=False)\n",
    ")\n",
    "\n",
    "# 6. Convert numeric columns\n",
    "numeric_columns = [\n",
    "    \"Delivery_person_Age\",\n",
    "    \"Delivery_person_Ratings\",\n",
    "    \"multiple_deliveries\"\n",
    "]\n",
    "\n",
    "for col in numeric_columns:\n",
    "    df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
    "\n",
    "print(\"Cleaning completed!\")"
   ]
  },
